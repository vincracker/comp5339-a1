# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Raw and intermediate data -- regenerated by scripts, not committed.
# data/external/ is deliberately NOT ignored: it caches augmentation responses.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# DuckDB build output -- rebuilt by src/db/load.py.
# NOTE: the .duckdb file IS a required deliverable. Include it in the submission
# zip even though it is not tracked in git.
*.duckdb
*.duckdb.wal

# Secrets
.env

# Jupyter
.ipynb_checkpoints/

# NOTE: uv.lock IS committed -- it pins exact versions for the group's own
# environment. requirements.txt is the separate, exported deliverable that must
# install under plain `venv` + `pip`.

# Safety net: notebooks must resolve data/ from the repo root, never write it
# alongside themselves. The rules above are anchored to the repo root, so they
# would not catch a stray copy here.
notebooks/data/
