# Copy to .env and fill in. NEVER commit the real .env -- it is gitignored.
#
# Only the person running the augmentation fetch needs a key. The OCM and OSM
# responses are cached under data/external/ and committed, so the rest of the
# group can run the full pipeline without registering for anything.

# --- Task 3: data augmentation ----------------------------------------------
# Free, non-commercial use. Register an account at https://openchargemap.org,
# then create an application in your profile to be issued a key.
OPENCHARGEMAP_API_KEY=

# Note: no key is needed for Task 1. The acquisition notebook uses the public
# data.gov.au CKAN API and a direct ABS download, neither of which authenticates.
# The second augmentation source (OpenStreetMap via Overpass) is also keyless.
